config ZMK_INERTIA_RUNTIME
    bool "Inertia scroll runtime adjustment (DYA)"
    help
      mjmjm0101/zmk-input-processor-scroll-inertia (scroll_inertia_free)
      friction / limit / decay-fast/slow/tail 等を custom-settings
      経由で実行時に調整するための土台。
      Phase2a (RAMのみ) では custom-settings 不要。
      Phase2b (永続化) で ZMK_CUSTOM_SETTINGS が必要。
      n のままなら mjm 素の DT 動作と同一 (完全ロールバック)。

if ZMK_INERTIA_RUNTIME

config ZMK_INERTIA_RUNTIME_STUDIO_RPC
    bool "Inertia Studio RPC"
    default y
    depends on ZMK_STUDIO
    help
      DYA Studio から読み書きするための RPC。Phase3 で実装。

